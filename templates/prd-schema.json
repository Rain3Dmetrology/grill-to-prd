{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rain3Dmetrology/grill-to-prd/blob/main/templates/prd-schema.json",
  "title": "grill-to-PRD structured artifact",
  "description": "Canonical PRD artifact schema. It describes requirements, not an executable Harness TaskContract.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "mode",
    "domain",
    "goal",
    "requirements",
    "acceptance",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_plan"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "fast",
        "deep",
        "wayfinder"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "goal": {
      "type": "object",
      "required": [
        "purpose",
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string"
              },
              "baseline": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "method": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": [
        "functional",
        "non_functional"
      ],
      "properties": {
        "functional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "must",
                  "should",
                  "could",
                  "wont"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "non_functional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "must",
                  "should",
                  "could",
                  "wont"
                ]
              },
              "measurement": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "verification_method",
          "expected_result",
          "kind",
          "gate",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "automated_test",
              "manual_review",
              "benchmark",
              "data_check",
              "operational_check",
              "inspection",
              "other"
            ]
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "deterministic",
              "semantic",
              "human_acceptance",
              "physical"
            ]
          },
          "gate": {
            "type": "string",
            "enum": [
              "verification",
              "closure"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "environment": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unverified"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "repository",
                  "file",
                  "official_documentation",
                  "api",
                  "dataset",
                  "web",
                  "user_input",
                  "other"
                ]
              },
              "uri": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "unverified",
              "rejected"
            ]
          },
          "impact": {
            "type": "string"
          },
          "validation_method": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "status",
          "decision_owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chosen_option": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "accepted",
              "rejected",
              "deferred"
            ]
          },
          "decision_owner": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "policy"
            ]
          },
          "user_confirmed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "user_stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "as_a",
          "i_want",
          "so_that",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "as_a": {
            "type": "string"
          },
          "i_want": {
            "type": "string"
          },
          "so_that": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could",
              "wont"
            ]
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invest": {
            "type": "object",
            "properties": {
              "independent": {
                "type": "boolean"
              },
              "negotiable": {
                "type": "boolean"
              },
              "valuable": {
                "type": "boolean"
              },
              "estimable": {
                "type": "boolean"
              },
              "small": {
                "type": "boolean"
              },
              "testable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "context",
          "decision",
          "alternatives",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consequences": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "deprecated"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "traceability_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "acceptance_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "design_ref": {
            "type": "string"
          },
          "implementation_ref": {
            "type": "string"
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "data_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "attributes",
          "states",
          "transitions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "guard": {
                  "type": "string"
                },
                "effect": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "pipeline_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sequential",
              "parallel",
              "conditional",
              "fanout",
              "join"
            ]
          },
          "trigger": {
            "type": "string"
          },
          "data_lineage": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "error_personality": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario",
          "detection",
          "fallback",
          "recovery"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "detection": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          },
          "recovery": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "blocking",
          "owner",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "external"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "answered",
              "deferred"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "user_confirmation": {
      "type": "object",
      "properties": {
        "consensus_confirmed": {
          "type": "boolean"
        },
        "confirmed_by": {
          "type": "string"
        },
        "confirmed_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Optional domain-specific additions that do not change the core PRD contract.",
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "description": "Optional explicitly authored relationships; graph_derive.py renders these and does not infer new relations.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "depends_on",
              "constrained_by",
              "locked_by",
              "relates",
              "supports",
              "contradicts"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
